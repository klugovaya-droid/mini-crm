# Public frontend variables. Only the anon key is allowed here.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# Local/seed scripts only. Never expose this key through VITE_*.
SUPABASE_SERVICE_ROLE_KEY=

# Password for demo users created by `npm run seed:local`.
DEMO_PASSWORD=Demo1234!
